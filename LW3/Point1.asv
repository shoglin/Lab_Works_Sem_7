%% Очистка рабочей области
clear; clc; close all;

%% 1. Установка путей проекта
project_folder = 'C:\Users\user\Desktop\Lab_Work_Sem_7\LW3';
data_folder = fullfile(project_folder, 'LatLon');

if ~exist(data_folder, 'dir')
    error('Папка с данными не найдена по пути: %s', data_folder);
end

cd(project_folder); % Делаем корень проекта рабочей директорией

%% 2. Выбор файла Excel с данными СНС
[file, path] = uigetfile({'*.xlsx;*.xls', 'Файлы Excel (*.xlsx, *.xls)'}, ...
                         'Выберите файл с данными LatLon', data_folder);
if isequal(file, 0)
    disp('Выбор файла отменен.');
    return;
end
filepath = fullfile(path, file);

%% 3. Загрузка и подготовка данных
% Чтение Excel файла (3 столбца: [Время, Широта, Долгота])
data = readmatrix(filepath);

t = data(:, 1);         % Время (с)
lat_raw = data(:, 2);   % Широта (градусы)
lon_raw = data(:, 3);   % Долгота (градусы)

N = length(t);

% Перевод широты/долготы в локальные метры (Относительно первой точки)
R_earth = 6371000; % Средний радиус Земли в метрах
lat0 = lat_raw(1);
lon0 = lon_raw(1);

x_raw = (lon_raw - lon0) .* (pi/180) .* R_earth .* cosd(lat0); % Восток (м)
y_raw = (lat_raw - lat0) .* (pi/180) .* R_earth;              % Север (м)

%% 4. Фильтр Низких Частот (ФНЧ / Экспоненциальное сглаживание)
% Уравнение: y[k] = alpha * x[k] + (1 - alpha) * y[k-1]
% alpha — коэффициент сглаживания (чем меньше alpha, тем сильнее сглаживание)
alpha = 0.08; 

x_filt = zeros(N, 1);
y_filt = zeros(N, 1);

% Инициализация фильтра начальным значением
x_filt(1) = x_raw(1);
y_filt(1) = y_raw(1);

% Алгоритм фильтрации в реальном времени
for i = 2:N
    x_filt(i) = alpha * x_raw(i) + (1 - alpha) * x_filt(i-1);
    y_filt(i) = alpha * y_raw(i) + (1 - alpha) * y_filt(i-1);
end

% Перевод обратно в широту и долготу
lat_filt = lat0 + (y_filt / R_earth) .* (180/pi);
lon_filt = lon0 + (x_filt / (R_earth * cosd(lat0))) .* (180/pi);

%% 5. Оценка точности и времени сходимости
% Оценка шума после 10-й секунды (установившийся режим)
settling_idx = find(t >= 10, 1, 'first');
if isempty(settling_idx), settling_idx = 10; end

smooth_x = movmean(x_filt, 5);
smooth_y = movmean(y_filt, 5);
noise_amplitude = sqrt((x_filt(settling_idx:end) - smooth_x(settling_idx:end)).^2 + ...
                       (y_filt(settling_idx:end) - smooth_y(settling_idx:end)).^2);
max_noise = max(noise_amplitude);

fprintf('=== Результаты обработки (ФНЧ) ===\n');
fprintf('Обрабатываемый файл: %s\n', file);
fprintf('Коэффициент альфа (alpha): %.2f\n', alpha);
fprintf('Максимальная амплитуда шума после 10 с: %.4f м (Требование: <= 0.1 м)\n', max_noise);

%% 6. Построение графиков
fig = figure('Name', 'Результаты работы ФНЧ', 'Color', 'w');
fig.Position = [100 100 800 600];

subplot(2,1,1);
plot(x_raw, y_raw, 'r.', 'DisplayName', 'Исходные данные'); hold on;
plot(x_filt, y_filt, 'b-', 'LineWidth', 1.5, 'DisplayName', 'ФНЧ');
grid on;
title('Траектория движения (в локальных метрах)');
xlabel('X, Восток (м)'); ylabel('Y, Север (м)');
legend('Location', 'best');
ax = gca; ax.FontSize = 11;

subplot(2,1,2);
plot(t(settling_idx:end), noise_amplitude, 'k-', 'LineWidth', 1.2); hold on;
yline(0.1, 'r--', 'Порог 0.1 м', 'LineWidth', 1.5);
grid on;
title('Оценка остаточного шума (после 10 с)');
xlabel('Время (с)'); ylabel('Шум (м)');
ax = gca; ax.FontSize = 11;

%% 7. Формирование отчета в MS Word через actxserver[cite: 1]
try
    disp('Формирование отчета в MS Word...');
    Word = actxserver('Word.Application'); % Подключение к MS Word[cite: 1]
    Word.Visible = true;
    
    doc = Word.Documents.Add();
    selection = Word.Selection;
    
    selection.TypeText('Отчет: Фильтрация данных СНС с использованием ФНЧ');
    selection.TypeParagraph();
    
    selection.TypeText(sprintf('Исходный файл: %s\n', file));
    selection.TypeText(sprintf('Тип фильтра: Дискретный ФНЧ 1-го порядка (alpha = %.2f)\n', alpha));
    selection.TypeText(sprintf('Время сходимости: <= 10 сек.\n'));
    selection.TypeText(sprintf('Максимальная амплитуда шума: %.4f м.\n', max_noise));
    
    if max_noise <= 0.1
        selection.TypeText('Вывод: Требования по точности (<= 0.1 м) выполнены.\n');
    else
        selection.TypeText('Вывод: Для снижения шума уменьшите значение параметра alpha.\n');
    end
    selection.TypeParagraph();
    
    % Вставка графика в документ[cite: 1]
    copygraphics(fig);
    selection.Paste();
    
    % Сохранение документа в папку проекта[cite: 1]
    report_filename = fullfile(project_folder, sprintf('Отчет_ФНЧ_%s.docx', erase(file, '.xlsx')));
    doc.SaveAs2(report_filename);
    fprintf('Отчет сохранен: %s\n', report_filename);
    
catch ME
    warning('Не удалось сформировать отчет Word. Ошибка: %s', ME.message);
end